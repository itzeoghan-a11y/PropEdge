# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=propedge
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=propedge
DATABASE_URL=postgresql+asyncpg://propedge:change_me_in_production@localhost:5432/propedge

# ── Cache / Queue ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ELITE=price_...

# ── Odds API (The Odds API) ───────────────────────────────────────────────────
ODDS_API_KEY=your_odds_api_key

# ── Sports Data (sportradar or similar) ───────────────────────────────────────
SPORTS_DATA_API_KEY=your_sports_data_key

# ── Alerts ────────────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
SENDGRID_API_KEY=SG....
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_ML_MODEL=true
ODDS_POLL_INTERVAL=30
STEAM_DETECTION_WINDOW_SECONDS=300
MIN_EV_THRESHOLD=0.03
MIN_CONFIDENCE_THRESHOLD=50
